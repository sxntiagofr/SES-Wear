# ============================================================================
#  CLAVES DE API DE SES WEAR
# ============================================================================
#  1. Copia este archivo en esta misma carpeta con el nombre:  .secret.local
#     (o corre scripts/configurar-claves.ps1 / .sh, que lo crea por ti).
#  2. Reemplaza cada PEGA_AQUI_... por tu clave, sin comillas ni espacios.
#
#  .secret.local NO se sube a GitHub (está en el .gitignore).
#  Lo usan el servidor de prueba (npm run prueba), el emulador de Firebase y
#  el script scripts/configurar-claves, que copia las claves al gestor de
#  secretos de Firebase (Secret Manager) para la app publicada.
#  Nunca pongas estas claves dentro del código ni de la app Flutter.
# ============================================================================

# Gemini (chat del asistente e identificación de prendas)
# Se crea gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=PEGA_AQUI_TU_CLAVE_DE_GEMINI

# remove.bg (quitar el fondo de las fotos; 50 fotos gratis al mes)
# Se crea en https://www.remove.bg/dashboard#api-key
REMOVE_BG_API_KEY=PEGA_AQUI_TU_CLAVE_DE_REMOVE_BG

# Opcional: forzar un solo modelo de Gemini (por defecto se usa gemini-3.5-flash
# y, si está saturado, gemini-flash-lite-latest).
# CHATBOT_MODEL=gemini-3.5-flash
