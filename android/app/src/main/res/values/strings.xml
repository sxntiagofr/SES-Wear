<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Inicio de sesión con Facebook (ver docs/autenticacion.md).
      1. Crea la app en https://developers.facebook.com (tipo "Consumidor").
      2. Copia el App ID y el Client Token (Configuración → Avanzada) aquí.
      3. fb_login_protocol_scheme es "fb" seguido del App ID, ej.: fb1234567890.
      4. En lib/core/config/auth_config.dart cambia facebookConfigurado a true.
      Estos valores son públicos (van dentro de la app); no son secretos.
    -->
    <string name="facebook_app_id">PON_AQUI_EL_APP_ID_DE_FACEBOOK</string>
    <string name="facebook_client_token">PON_AQUI_EL_CLIENT_TOKEN_DE_FACEBOOK</string>
    <string name="fb_login_protocol_scheme">fbPON_AQUI_EL_APP_ID_DE_FACEBOOK</string>
</resources>
