rules_version = '2';

// Reglas de Cloud Firestore de SES Wear.
// Estructura completa de la base de datos en docs/base-de-datos.md.
//
// - Cada usuario solo puede leer y escribir sus propios datos: users/{uid} y
//   sus subcolecciones.
// - Las subcolecciones que escribe la app validan campos y tipos, para que un
//   documento mal formado no rompa las pantallas.
// - El contador de uso de remove.bg (cupo diario) solo lo escribe el servidor
//   (Cloud Functions con el Admin SDK).
// - Nadie puede darse a sí mismo el rol de administrador: el campo `rol` nace
//   como "usuario" y solo lo cambia el Admin SDK.
// - Todo lo demás queda bloqueado por defecto.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Texto obligatorio de 1 a `max` caracteres.
    function textoValido(valor, max) {
      return valor is string && valor.size() > 0 && valor.size() <= max;
    }

    // Campo opcional: si viene, debe cumplir la condición.
    function opcional(d, campo, tipo) {
      return !(campo in d) || d[campo] == null
        || (tipo == 'string' && d[campo] is string && d[campo].size() <= 500)
        || (tipo == 'number' && d[campo] is number && d[campo] >= 0)
        || (tipo == 'int' && d[campo] is int && d[campo] >= 0)
        || (tipo == 'bool' && d[campo] is bool)
        || (tipo == 'timestamp' && d[campo] is timestamp)
        || (tipo == 'list' && d[campo] is list && d[campo].size() <= 30);
    }

    // Campos que la app puede escribir en el perfil.
    function camposPerfilValidos() {
      return request.resource.data.keys().hasOnly([
        'email', 'nombre', 'apellido', 'telefono', 'ciudad', 'fotoUrl',
        'proveedor', 'rol', 'locale', 'preferencias', 'consentimientoDatos',
        'fechaRegistro', 'ultimoAcceso'
      ]);
    }

    function prendaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'nombre', 'tipo', 'categoria', 'colorPrimario', 'colorSecundario', 'tela',
          'estilo', 'formalidad', 'estacion', 'etiquetas', 'fotoUrl', 'vecesUsada',
          'identificadaPorIA', 'fechaCreacion', 'precio', 'ultimoUso'
        ])
        && textoValido(d.nombre, 100)
        && d.tipo in ['superior', 'inferior', 'calzado', 'accesorio', 'enterizo', 'abrigo']
        && (!('formalidad' in d) || d.formalidad in ['casual', 'deportivo', 'semiformal', 'formal', 'fiesta'])
        && (!('estacion' in d) || d.estacion in ['calor', 'frío', 'lluvia', 'todo el año'])
        && opcional(d, 'categoria', 'string') && opcional(d, 'colorPrimario', 'string')
        && opcional(d, 'colorSecundario', 'string') && opcional(d, 'tela', 'string')
        && opcional(d, 'estilo', 'string') && opcional(d, 'fotoUrl', 'string')
        && opcional(d, 'etiquetas', 'list') && opcional(d, 'vecesUsada', 'int')
        && opcional(d, 'identificadaPorIA', 'bool') && opcional(d, 'precio', 'number')
        && opcional(d, 'ultimoUso', 'timestamp') && opcional(d, 'fechaCreacion', 'timestamp');
    }

    function outfitValido() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'nombre', 'ocasion', 'clima', 'prendaIds', 'explicacion', 'favorito',
          'calificacion', 'origen', 'fechaCreacion'
        ])
        && textoValido(d.nombre, 100)
        && d.prendaIds is list && d.prendaIds.size() >= 1 && d.prendaIds.size() <= 10
        && opcional(d, 'ocasion', 'string') && opcional(d, 'clima', 'string')
        && opcional(d, 'explicacion', 'string') && opcional(d, 'favorito', 'bool')
        && (!('calificacion' in d) || (d.calificacion is int && d.calificacion >= 0 && d.calificacion <= 5))
        && (!('origen' in d) || d.origen in ['local', 'ia', 'manual'])
        && opcional(d, 'fechaCreacion', 'timestamp');
    }

    function coleccionValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nombre', 'descripcion', 'prendaIds', 'fechaCreacion'])
        && textoValido(d.nombre, 60)
        && d.prendaIds is list && d.prendaIds.size() <= 300
        && opcional(d, 'descripcion', 'string') && opcional(d, 'fechaCreacion', 'timestamp');
    }

    function planValido(fecha) {
      let d = request.resource.data;
      return fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.keys().hasOnly(['fecha', 'outfitId', 'outfitNombre', 'prendaIds', 'nota', 'actualizado'])
        && d.fecha == fecha
        && d.prendaIds is list && d.prendaIds.size() <= 10
        && opcional(d, 'outfitId', 'string') && opcional(d, 'outfitNombre', 'string')
        && opcional(d, 'nota', 'string') && opcional(d, 'actualizado', 'timestamp');
    }

    function conversacionValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['titulo', 'fechaCreacion', 'ultimaActividad'])
        && opcional(d, 'titulo', 'string')
        && opcional(d, 'fechaCreacion', 'timestamp') && opcional(d, 'ultimaActividad', 'timestamp');
    }

    function mensajeValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['rol', 'texto', 'tieneFoto', 'rechazado', 'fecha'])
        && d.rol in ['usuario', 'asistente']
        && d.texto is string && d.texto.size() <= 8000
        && opcional(d, 'tieneFoto', 'bool') && opcional(d, 'rechazado', 'bool')
        && d.fecha is timestamp;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
                    && camposPerfilValidos()
                    && request.resource.data.get('rol', 'usuario') == 'usuario';

      allow update: if isOwner(uid)
                    && camposPerfilValidos()
                    && request.resource.data.get('rol', 'usuario') == resource.data.get('rol', 'usuario')
                    && request.resource.data.get('fechaRegistro', null) == resource.data.get('fechaRegistro', null);

      // Derecho de supresión (Ley 1581 de 2012). El borrado completo, con
      // subcolecciones y fotos, lo hace la Cloud Function `eliminarCuenta`.
      allow delete: if isOwner(uid);

      match /prendas/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && prendaValida();
      }

      match /outfits/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && outfitValido();
      }

      match /colecciones/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && coleccionValida();
      }

      match /planificador/{fecha} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && planValido(fecha);
      }

      // Historial del asistente: lo escribe la app (asistente_repositorio.dart)
      // después de cada respuesta de Gemini (Firebase AI Logic).
      match /conversaciones/{conversacionId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && conversacionValida();
        match /mensajes/{mensajeId} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid) && mensajeValido();
        }
      }

      // Contador de usos diarios de las funciones de IA (functions/src/limites.js).
      match /uso/{dia} {
        allow read: if isOwner(uid);
      }
    }

    // Catálogo global de categorías y parámetros del sistema (RF-08):
    // cualquier usuario con sesión los lee; solo el administrador los cambia.
    match /categorias/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /parametros/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
